# macOS
.DS_Store

# Cursor local (commands/rules stay machine-local unless force-added)
.cursor/

# Xcode user/local state
DerivedData/
DesktopApp/build/
*.xcuserstate/
*.xcuserdata/
*.xcworkspace/
*.xcodeproj/xcuserdata/

# Python cache/env
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*
!.env.example

# Logs / launcher runtime
*.log
.kb_backend.pid
.kb_backend.log

# Optional per-machine extension ID
chrome-extension/.extension-id

# Runtime graph state (legacy desktop graph)
.graph-dependencies.json

# Local browser e2e leftovers
node_modules/
.tmp-e2e/

# Root directory for all knowledge base storage.
# Default: ~/.kb/
KB_ROOT=~/.kb

# Local Ollama model used for chat and classification.
# Default: qwen2.5:3b  (run: ollama pull qwen2.5:3b)
KB_CHAT_MODEL=qwen2.5:3b

# Ollama model used for text embeddings / semantic search.
# Default: nomic-embed-text  (run: ollama pull nomic-embed-text)
KB_EMBED_MODEL=nomic-embed-text

# Port the Python backend listens on.
# Default: 8765
KB_PORT=8765

# LLM provider: auto | ollama | openai | anthropic
# auto: uses OpenAI when OPENAI_API_KEY is set, otherwise Ollama
KB_LLM_PROVIDER=auto

# OpenAI — set your key to use GPT models (no Ollama required for chat/search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Embeddings: auto | ollama | openai
# auto: uses OpenAI embeddings when OPENAI_API_KEY is set
KB_EMBED_PROVIDER=auto

# Anthropic (when KB_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Calendar OAuth credentials
# Get these from console.cloud.google.com → APIs & Services → Credentials
# Scopes needed: https://www.googleapis.com/auth/calendar.readonly
KB_GCAL_CLIENT_ID=
KB_GCAL_CLIENT_SECRET=

# Gmail OAuth credentials
# Get these from console.cloud.google.com → APIs & Services → Credentials
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
KB_GMAIL_CLIENT_ID=
KB_GMAIL_CLIENT_SECRET=
